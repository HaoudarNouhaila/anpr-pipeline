# Copier ce fichier en .env et renseigner vos propres valeurs.
# Le fichier .env est exclu du depot par .gitignore.

# Cle de hachage des plaques (HMAC-SHA256).
# Sans cle, le hachage est impossible : il n'y a volontairement aucune valeur
# par defaut, un secret ecrit en dur n'etant pas un secret.
# Generer une cle :
#   python -c "import secrets; print(secrets.token_hex(32))"
ANPR_HASH_KEY=

# Surcharges facultatives de configs/default.yaml
# ANPR_COUNTRIES=FR,ES
# ANPR_HASH_PLATES=true
# ANPR_PLATE_CONFIDENCE=0.3
